[
  {
    "id": "SM-01",
    "domain": "订单",
    "transition": "DRAFT→PUBLISHED",
    "actor": "商家发布",
    "guard": "审核通过/商品在架/金额快照固定",
    "idempotency": "orderId+publishVersion",
    "journal": "无",
    "quota": "无",
    "notification": "待确认"
  },
  {
    "id": "SM-02",
    "domain": "订单/履约/预占",
    "transition": "PUBLISHED→CONFIRMED; NOT_READY→READY; 新建HELD",
    "actor": "用户确认",
    "guard": "凭证有效、快照一致、余额足够",
    "idempotency": "confirmationNonce+orderId",
    "journal": "无资金分录",
    "quota": "新增预占",
    "notification": "已确认"
  },
  {
    "id": "SM-03",
    "domain": "订单",
    "transition": "PUBLISHED→CANCELLED/EXPIRED",
    "actor": "用户拒绝/商家取消/系统到期",
    "guard": "尚未确认",
    "idempotency": "orderId+close",
    "journal": "无",
    "quota": "无",
    "notification": "结果"
  },
  {
    "id": "SM-04",
    "domain": "订单/履约/预占",
    "transition": "CONFIRMED→CANCELLED/EXPIRED; READY→VOID; HELD→RELEASED/EXPIRED",
    "actor": "取消/到期任务",
    "guard": "尚未履约；锁定同订单",
    "idempotency": "reservationId+release",
    "journal": "无",
    "quota": "释放一次",
    "notification": "取消/到期"
  },
  {
    "id": "SM-05",
    "domain": "订单/履约/预占/应收",
    "transition": "CONFIRMED→FULFILLED; READY→FULFILLED; HELD→CONSUMED; 新建OPEN",
    "actor": "核销员履约",
    "guard": "核销nonce有效、预占未到期",
    "idempotency": "orderId+fulfill",
    "journal": "J-01",
    "quota": "预占转本金，总占用不变",
    "notification": "账单生成"
  },
  {
    "id": "SM-06",
    "domain": "应收",
    "transition": "OPEN→PARTIAL/SETTLED; PARTIAL→PARTIAL/SETTLED",
    "actor": "确认还款",
    "guard": "入账后剩余本金计算",
    "idempotency": "paymentEventId+allocationId",
    "journal": "J-02/J-03",
    "quota": "按核销本金释放",
    "notification": "还款结果"
  },
  {
    "id": "SM-07",
    "domain": "应收",
    "transition": "OPEN/PARTIAL→PARTIAL/SETTLED",
    "actor": "退款审批",
    "guard": "退款上限和独立审批通过",
    "idempotency": "refundId+apply",
    "journal": "J-04",
    "quota": "仅冲本金部分释放",
    "notification": "退款结果"
  },
  {
    "id": "SM-08",
    "domain": "还款",
    "transition": "CREATED→PENDING",
    "actor": "模拟渠道受理",
    "guard": "SIM_ONLY，收款商家一致",
    "idempotency": "repaymentId+submit",
    "journal": "无",
    "quota": "无",
    "notification": "处理中"
  },
  {
    "id": "SM-09",
    "domain": "还款",
    "transition": "PENDING→CONFIRMED",
    "actor": "模拟结果/核实",
    "guard": "验签/金额/商家/环境一致",
    "idempotency": "providerEventId",
    "journal": "J-02/J-03",
    "quota": "实际分配本金释放",
    "notification": "结果"
  },
  {
    "id": "SM-10",
    "domain": "还款",
    "transition": "CREATED/PENDING→FAILED/CLOSED",
    "actor": "明确失败/关单",
    "guard": "失败已查询；不把未知当失败",
    "idempotency": "repaymentId+close",
    "journal": "无",
    "quota": "无",
    "notification": "结果"
  },
  {
    "id": "SM-11",
    "domain": "还款",
    "transition": "CLOSED/FAILED→EXCEPTION",
    "actor": "迟到成功",
    "guard": "验证通过但原单已关闭/已被其他事件替代",
    "idempotency": "providerEventId",
    "journal": "J-03（暂存）",
    "quota": "待复核不释放",
    "notification": "差异工单"
  },
  {
    "id": "SM-12",
    "domain": "还款",
    "transition": "EXCEPTION→CONFIRMED",
    "actor": "独立差异复核",
    "guard": "再次校验可分配本金/应退余额",
    "idempotency": "differenceId+resolve",
    "journal": "J-07",
    "quota": "仅新分配本金释放",
    "notification": "复核结果"
  },
  {
    "id": "SM-13",
    "domain": "退款",
    "transition": "REQUESTED→APPROVED/REJECTED",
    "actor": "独立审核",
    "guard": "不是发起人/可退额足够",
    "idempotency": "refundId+decisionVersion",
    "journal": "通过J-04",
    "quota": "本金冲减一次",
    "notification": "审批结果"
  },
  {
    "id": "SM-14",
    "domain": "退款",
    "transition": "APPROVED→SUCCEEDED",
    "actor": "系统",
    "guard": "仅冲本金无需模拟现金退回",
    "idempotency": "refundId+complete",
    "journal": "无新增",
    "quota": "无",
    "notification": "完成"
  },
  {
    "id": "SM-15",
    "domain": "退款",
    "transition": "APPROVED→PROCESSING",
    "actor": "模拟退回",
    "guard": "存在应退金额",
    "idempotency": "refundId+submit",
    "journal": "无",
    "quota": "无",
    "notification": "处理中"
  },
  {
    "id": "SM-16",
    "domain": "退款",
    "transition": "PROCESSING→SUCCEEDED",
    "actor": "模拟退回结果",
    "guard": "验签+一致核对",
    "idempotency": "providerEventId",
    "journal": "J-05",
    "quota": "无",
    "notification": "完成"
  },
  {
    "id": "SM-17",
    "domain": "退款",
    "transition": "PROCESSING→FAILED/EXCEPTION",
    "actor": "明确失败/不一致",
    "guard": "已批准冲减不撤销；应退仍保留",
    "idempotency": "refundId+failure",
    "journal": "无",
    "quota": "无",
    "notification": "失败/待处理"
  },
  {
    "id": "SM-18",
    "domain": "退款",
    "transition": "FAILED/EXCEPTION→PROCESSING",
    "actor": "独立重试审批",
    "guard": "查原单避免重复退回",
    "idempotency": "refundId+retryAttempt",
    "journal": "无",
    "quota": "无",
    "notification": "重试"
  },
  {
    "id": "SM-19",
    "domain": "争议",
    "transition": "新建OPEN→REVIEWING",
    "actor": "用户/客服",
    "guard": "本人交易/任务分配",
    "idempotency": "disputeId+start",
    "journal": "无",
    "quota": "不释放；可冻结新增资格",
    "notification": "工单结果"
  },
  {
    "id": "SM-20",
    "domain": "争议",
    "transition": "REVIEWING→RESOLVED",
    "actor": "处理人",
    "guard": "证据、理由、可申诉结果",
    "idempotency": "disputeId+resolutionVersion",
    "journal": "无；金额变更另开调整单",
    "quota": "无",
    "notification": "结论"
  },
  {
    "id": "SM-21",
    "domain": "争议",
    "transition": "RESOLVED→APPEALED→REVIEWING",
    "actor": "用户申诉/复核人",
    "guard": "在告知窗口内，复核人独立",
    "idempotency": "disputeId+appealVersion",
    "journal": "无",
    "quota": "无",
    "notification": "受理"
  },
  {
    "id": "SM-22",
    "domain": "争议",
    "transition": "RESOLVED→CLOSED",
    "actor": "用户确认/系统截止",
    "guard": "用户已被告知结果及申诉入口",
    "idempotency": "disputeId+close",
    "journal": "无",
    "quota": "无",
    "notification": "关闭"
  },
  {
    "id": "SM-23",
    "domain": "更正",
    "transition": "REQUESTED→APPROVED/REJECTED",
    "actor": "账务复核员",
    "guard": "双人、原事件、影响分析",
    "idempotency": "adjustmentId+decisionVersion",
    "journal": "无",
    "quota": "无",
    "notification": "结果"
  },
  {
    "id": "SM-24",
    "domain": "更正",
    "transition": "APPROVED→POSTED",
    "actor": "账务服务",
    "guard": "限定下调/重复事件纠错；余额校验",
    "idempotency": "adjustmentId+post",
    "journal": "J-06",
    "quota": "仅确认的本金差额释放",
    "notification": "更正结果"
  },
  {
    "id": "SM-25",
    "domain": "对账",
    "transition": "CREATED→RUNNING",
    "actor": "对账任务",
    "guard": "文件校验/批次唯一",
    "idempotency": "date+merchant+fileHash",
    "journal": "无",
    "quota": "无",
    "notification": "可查进度"
  },
  {
    "id": "SM-26",
    "domain": "对账",
    "transition": "RUNNING→MATCHED/DIFFERENCE/FAILED",
    "actor": "核对任务",
    "guard": "规则执行/差异行/解析异常",
    "idempotency": "reconciliationId+runVersion",
    "journal": "无",
    "quota": "无",
    "notification": "任务结果"
  },
  {
    "id": "SM-27",
    "domain": "对账",
    "transition": "DIFFERENCE→RESOLVED",
    "actor": "独立复核",
    "guard": "全部差异逐条有结果，不改原文件",
    "idempotency": "reconciliationId+close",
    "journal": "无；纠错由独立单据入账",
    "quota": "无",
    "notification": "汇总"
  },
  {
    "id": "SM-28",
    "domain": "结算",
    "transition": "NOT_APPLICABLE→NOT_APPLICABLE",
    "actor": "无首期动作",
    "guard": "首期不结算",
    "idempotency": "不适用",
    "journal": "无",
    "quota": "无",
    "notification": "不显示操作按钮"
  },
  {
    "id": "SM-29",
    "domain": "保证金",
    "transition": "NOT_APPLICABLE→NOT_APPLICABLE",
    "actor": "无首期动作",
    "guard": "首期不收保证金",
    "idempotency": "不适用",
    "journal": "无",
    "quota": "无",
    "notification": "不显示操作按钮"
  },
  {
    "id": "SM-30",
    "domain": "业务日",
    "transition": "OPEN→CLOSING",
    "actor": "账务任务执行获批CLOSE",
    "guard": "已到日截止、独立批准、无阻断差异、版本一致",
    "idempotency": "dayId+requestId+close",
    "journal": "无新增分录；固定截止水位",
    "quota": "不释放",
    "notification": "关账处理中"
  },
  {
    "id": "SM-31",
    "domain": "业务日",
    "transition": "CLOSING→CLOSED",
    "actor": "关账任务",
    "guard": "借贷/投影/对账一致，快照和hash已保存",
    "idempotency": "requestId+snapshotRevision",
    "journal": "无；报告只读",
    "quota": "不释放",
    "notification": "关账完成"
  },
  {
    "id": "SM-32",
    "domain": "业务日",
    "transition": "CLOSING→OPEN",
    "actor": "关账任务失败恢复",
    "guard": "仅控制状态恢复，保留失败证据；历史日仍禁止回填",
    "idempotency": "requestId+failure",
    "journal": "无",
    "quota": "不释放",
    "notification": "受阻/重新申请"
  },
  {
    "id": "SM-33",
    "domain": "业务日",
    "transition": "CLOSED→REOPENED_REVIEW",
    "actor": "执行独立批准的复核性重开",
    "guard": "请求有效、影响范围和原报告hash一致",
    "idempotency": "dayId+reopenRequestId",
    "journal": "不得改原分录；调整在当前日",
    "quota": "不释放",
    "notification": "复核窗口开启"
  },
  {
    "id": "SM-34",
    "domain": "业务日",
    "transition": "REOPENED_REVIEW→CLOSED",
    "actor": "执行获批重关",
    "guard": "复核证据齐全，新revision和新旧hash并存",
    "idempotency": "dayId+recloseRequestId",
    "journal": "无直接分录",
    "quota": "不释放",
    "notification": "新报告可查"
  },
  {
    "id": "SM-35",
    "domain": "关账请求",
    "transition": "REQUESTED→APPROVED/REJECTED",
    "actor": "独立账务复核员",
    "guard": "maker与checker不同且不为空，未到期，对象版本一致",
    "idempotency": "requestId+decisionVersion",
    "journal": "无",
    "quota": "不释放",
    "notification": "批准/驳回"
  },
  {
    "id": "SM-36",
    "domain": "关账请求",
    "transition": "APPROVED→EXECUTING→EXECUTED/FAILED；APPROVED→EXPIRED",
    "actor": "账务任务",
    "guard": "执行前验证有效期/对象版本；任务成功保存报告才EXECUTED；过期只阻止启动，不打断已提交入账",
    "idempotency": "requestId+execute",
    "journal": "动作本身不新增金额",
    "quota": "不释放",
    "notification": "执行结果"
  }
]
